{
  "name": "pi-cad",
  "version": "0.9.0",
  "description": "Harness-native agentic mechanical CAD for Pi with evidence-bound workflows, unified probes, Recipe-native simulation, and managed OpenFOAM, SU2, and CUDA torch-fem runtimes.",
  "type": "module",
  "bin": {
    "pi-cad": "./scripts/pi-cad-agent-api.mjs"
  },
  "keywords": [
    "pi-package",
    "cad",
    "build123d",
    "step",
    "mechanical-engineering"
  ],
  "pi": {
    "extensions": [
      "./src/integrations/prime/extension.ts",
      "./src/extensions/core/index.ts",
      "./src/extensions/probe/index.ts",
      "./src/extensions/geometry/index.ts",
      "./src/extensions/ui/index.ts",
      "./src/extensions/drawing/index.ts",
      "./src/extensions/simulation/index.ts",
      "./src/extensions/presentation/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "prime:plan-c": "node scripts/prime-plan-c.mjs",
    "generate:agent-contract": "node scripts/generate-agent-contract.mjs",
    "check:agent-contract": "node scripts/generate-agent-contract.mjs --check",
    "test": "npm run check:agent-contract && bash scripts/test.sh",
    "test:py": "bash scripts/test.sh",
    "test:ts": "node tests/run-ts-tests.mjs",
    "test:prime": "node tests/run-prime-tests.mjs",
    "test:openfoam14": "node scripts/qualify-openfoam14.mjs",
    "test:torch-fem-cuda": "node scripts/qualify-torch-fem-cuda.mjs",
    "test:su2": "node scripts/qualify-su2-8.5.0.mjs",
    "setup:simulation-runtimes": "bash -lc 'sudo scripts/bootstrap-openfoam14.sh && sudo scripts/bootstrap-su2-8.5.0.sh && sudo scripts/bootstrap-torch-fem-runtimes.sh'",
    "setup:python": "bash scripts/bootstrap-python.sh",
    "pack": "npm pack --cache .npm-cache",
    "postinstall": "node scripts/postinstall.mjs"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "jiti": "^2.7.0",
    "typebox": "^1.3.15"
  },
  "files": [
    "src",
    "skills",
    "python",
    "assets",
    "recipes",
    "benchmarks/README.md",
    "benchmarks/corpus.json",
    "benchmarks/run.mjs",
    "benchmarks/simulation-v2",
    "benchmarks/cadtestbench/README.md",
    "benchmarks/cadtestbench/final-report.py",
    "benchmarks/cadtestbench/run.mjs",
    "benchmarks/cadtestbench/sets",
    "scripts",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "package.json",
    "!**/__pycache__",
    "!**/*.py[cod]"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QiuYi111/pi-cad.git"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  }
}
