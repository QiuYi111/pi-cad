{
  "name": "pi-cad",
  "version": "0.1.0",
  "description": "Harness-native agentic mechanical CAD on Pi. V0 walking skeleton: Quick workflow with deterministic build/visual/geometry tools.",
  "type": "module",
  "keywords": [
    "pi-package",
    "cad",
    "build123d",
    "step",
    "mechanical-engineering"
  ],
  "private": true,
  "pi": {
    "extensions": [
      "./src/extensions/core/index.ts",
      "./src/extensions/geometry/index.ts",
      "./src/extensions/visual/index.ts"
    ]
  },
  "scripts": {
    "test": "bash scripts/test.sh",
    "test:py": "bash scripts/test.sh",
    "test:ts": "node tests/run-ts-tests.mjs",
    "setup:python": "bash scripts/bootstrap-python.sh"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "jiti": "^2.7.0",
    "typebox": "^1.3.15"
  },
  "files": [
    "src",
    "python",
    "README.md",
    "package.json"
  ]
}
