{
  "name": "pi-cad",
  "version": "0.6.0",
  "description": "Harness-native agentic mechanical CAD for Pi: seven workflows, deterministic build123d/STEP tools, evidence-bound harness, and optional drawing/simulation/presentation plugins.",
  "type": "module",
  "keywords": [
    "pi-package",
    "cad",
    "build123d",
    "step",
    "mechanical-engineering"
  ],
  "pi": {
    "extensions": [
      "./src/extensions/core/index.ts",
      "./src/extensions/geometry/index.ts",
      "./src/extensions/visual/index.ts",
      "./src/extensions/ui/index.ts",
      "./src/extensions/drawing/index.ts",
      "./src/extensions/simulation/index.ts",
      "./src/extensions/presentation/index.ts"
    ]
  },
  "scripts": {
    "test": "bash scripts/test.sh",
    "test:py": "bash scripts/test.sh",
    "test:ts": "node tests/run-ts-tests.mjs",
    "setup:python": "bash scripts/bootstrap-python.sh",
    "pack": "npm pack --cache .npm-cache",
    "postinstall": "node scripts/postinstall.mjs"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "jiti": "^2.7.0",
    "typebox": "^1.3.15"
  },
  "files": [
    "src",
    "python",
    "assets",
    "scripts",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QiuYi111/pi-cad.git"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  }
}
