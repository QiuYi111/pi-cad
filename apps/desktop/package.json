{
  "name": "pi-cad-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Desktop engineering workspace for Pi-CAD and Prime Agent",
  "author": "Pi-CAD contributors",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "stage:runtime": "node scripts/stage-runtime.mjs",
    "package:win": "npm run stage:runtime && npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.8",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.179.1",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/three": "^0.179.0",
    "@vitejs/plugin-react": "^5.0.2",
    "electron": "^37.4.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.4",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "com.picad.desktop",
    "productName": "Pi-CAD",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/runtime",
        "to": "runtime",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ],
      "artifactName": "Pi-CAD-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "allowScripts": {}
}
